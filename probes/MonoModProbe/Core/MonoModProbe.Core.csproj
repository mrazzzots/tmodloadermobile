<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- tModLoader stable ships MonoMod.RuntimeDetour 25.3.2. Override with -p:MonoModVersion=x.y.z -->
    <MonoModVersion Condition="'$(MonoModVersion)' == ''">25.3.2</MonoModVersion>
    <!-- Keep hook targets intact: no inlining surprises from the IL side -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoMod.RuntimeDetour" Version="$(MonoModVersion)" />
  </ItemGroup>

</Project>
