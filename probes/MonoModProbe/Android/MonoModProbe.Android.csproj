<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>TMLDroid.ProbeApp</RootNamespace>

    <ApplicationId>io.github.tmldroid.monomodprobe</ApplicationId>
    <ApplicationTitle>MonoMod Probe</ApplicationTitle>
    <ApplicationVersion>6</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.5</ApplicationDisplayVersion>

    <!-- arm64 only: that is what tModLoader on Android will target -->
    <!-- CI builds an extra android-x64 APK for the emulator with -p:TmlAndroidRid=android-x64 -->
    <TmlAndroidRid Condition="'$(TmlAndroidRid)' == ''">android-arm64</TmlAndroidRid>
    <RuntimeIdentifiers>$(TmlAndroidRid)</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <!--
      Mirror the real tModLoader situation: mod code is loaded at runtime and JIT-compiled.
      No trimming (mods reference arbitrary BCL APIs), no AOT (hooks must patch JIT code).
    -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidStripILAfterAOT>false</AndroidStripILAfterAOT>

    <!--
      MonoMod 25.x errors out for any TFM newer than .NET 9 (a CoreCLR concern; Android runs Mono).
      The error text says "MonoMod_CheckTargetRuntime", but the property actually read is this one.
    -->
    <MonoMod_ReallySkipCheckTargetRuntime>true</MonoMod_ReallySkipCheckTargetRuntime>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/MonoModProbe.Core.csproj" />
  </ItemGroup>

  <!-- libgcc_s replacement for MonoMod's native helper; produced by native/build-android-natives.sh -->
  <PropertyGroup>
    <ShimLib>$(MSBuildThisFileDirectory)../../../native/out/arm64-v8a/libmm_gcc_s_shim.so</ShimLib>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ShimLib)')">
    <!-- Loaded by absolute path at runtime: does not depend on how the APK stores native libs -->
    <EmbeddedResource Include="$(ShimLib)" LogicalName="libmm_gcc_s_shim.so" />
  </ItemGroup>
  <Target Name="WarnNoShim" BeforeTargets="Build" Condition="!Exists('$(ShimLib)')">
    <Warning Text="libmm_gcc_s_shim.so not found at $(ShimLib). The APK will run, but the 'with fix' mode will report the shim as missing. Run native/build-android-natives.sh first." />
  </Target>

  <!--
    Bionic has no glibc "__errno_location"; .NET for Android resolves "libc" imports itself, so a
    DllImportResolver cannot redirect them. Patch MonoMod.Core.dll's P/Invoke entry point to
    "__errno" (tools/MonoModAndroidPatcher) and package the patched copy instead.
  -->
  <PropertyGroup>
    <TmlPatcherProject>$(MSBuildThisFileDirectory)../../../tools/MonoModAndroidPatcher/MonoModAndroidPatcher.csproj</TmlPatcherProject>
    <TmlPatchedDir>$(MSBuildThisFileDirectory)obj/monomod-android/</TmlPatchedDir>
    <TmlPatchedMonoModCore>$(TmlPatchedDir)MonoMod.Core.dll</TmlPatchedMonoModCore>
  </PropertyGroup>

  <Target Name="TmlPatchMonoModCore" AfterTargets="ResolvePackageAssets" Condition="'$(TmlSkipMonoModPatch)' != 'true'">
    <ItemGroup>
      <_TmlMMCore Include="@(RuntimeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'MonoMod.Core.dll'" />
    </ItemGroup>
    <Error Condition="'@(_TmlMMCore)' == ''" Text="MonoMod.Core.dll not found in RuntimeCopyLocalItems" />
    <Exec Condition="!Exists('$(TmlPatchedMonoModCore)')"
          Command="dotnet run --project &quot;$(TmlPatcherProject)&quot; -c Release -- &quot;%(_TmlMMCore.FullPath)&quot; &quot;$(TmlPatchedMonoModCore)&quot;" />
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(_TmlMMCore)" />
      <RuntimeCopyLocalItems Include="@(_TmlMMCore->'$(TmlPatchedMonoModCore)')" />
    </ItemGroup>
    <Message Importance="high" Text="TMLDroid: using patched MonoMod.Core.dll ($(TmlPatchedMonoModCore))" />
  </Target>

  <!-- Safety net: replace any copy of the unpatched DLL that reached later item lists. -->
  <Target Name="TmlReplaceMonoModCoreLate" AfterTargets="ResolveAssemblyReferences;ComputeResolvedFilesToPublishList" Condition="'$(TmlSkipMonoModPatch)' != 'true'">
    <ItemGroup>
      <_TmlLateRCL Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'MonoMod.Core.dll' and '%(FullPath)' != '$([System.IO.Path]::GetFullPath($(TmlPatchedMonoModCore)))'" />
      <ReferenceCopyLocalPaths Remove="@(_TmlLateRCL)" />
      <ReferenceCopyLocalPaths Include="@(_TmlLateRCL->'$(TmlPatchedMonoModCore)')" />
      <_TmlLatePub Include="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'MonoMod.Core.dll' and '%(FullPath)' != '$([System.IO.Path]::GetFullPath($(TmlPatchedMonoModCore)))'" />
      <ResolvedFileToPublish Remove="@(_TmlLatePub)" />
      <ResolvedFileToPublish Include="@(_TmlLatePub->'$(TmlPatchedMonoModCore)')" />
    </ItemGroup>
  </Target>

</Project>
